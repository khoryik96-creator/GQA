# Copy this file to .env and fill BOTH values with independently generated secrets.
# GQA will refuse to start without them.
# Use unique random strings and never commit your filled .env.
GQA_ADMIN_PASSWORD=
GQA_RUNNER_TOKEN=
# Required: 32+ URL-safe characters, e.g. openssl rand -hex 32.
GQA_DB_APP_PASSWORD=
# Existing data volumes retain their previous PostgreSQL bootstrap password.
# For a fresh database, set this to a different random value, and keep it.
# GQA_DB_ADMIN_PASSWORD=
GQA_COOKIE_SECURE=false

# Optional experimental host-side Docker launcher (v0.10).
# Start the host launcher yourself and set GQA_RUNNER_HOST=host.docker.internal,
# GQA_RUNNER_PORT=18090. Keep default values when not testing this mode.
GQA_RUNNER_HOST=runner
GQA_RUNNER_PORT=8090
GQA_COMPOSE_PROJECT=gqa

# v0.11: enable administrator-only broker job inspection and cancellation
# when the API uses host.docker.internal:18090; disabled by default.
GQA_JOB_MANAGEMENT_ENABLED=false

# Optional: delete screenshots older than N days (0 means disabled).
# Set only after reviewing your evidence retention requirements.
GQA_EVIDENCE_RETENTION_DAYS=0
